# ccsw reads these from the environment. None is required, and none holds a secret.
# Copy to .env only if your shell loads one.

# Where profiles are stored. Default: ~/.config/account-switch
CCSW_HOME=

# The config directory that isolated sessions symlink back to. Default: ~/.claude
CCSW_SOURCE_DIR=

# Set to false to stop the session-start hook rewriting the /model list.
CCSW_AUTO_SYNC_MODELS=

# An OpenAI-style /v1/models URL whose models are appended to the /model list.
CCSW_EXTRA_MODELS_URL=

# Comma-separated owned_by values to keep from the extra models URL.
CCSW_EXTRA_MODELS_OWNERS=
